<odoo>
    <data noupdate="1">
        <!-- Inicio de comisiones: solo comisionan cobros desde esta fecha
             (decisión del cliente, 2 sep 2026). Editable en Ajustes. -->
        <record id="param_commission_start_date" model="ir.config_parameter">
            <field name="key">om_advanced_commission.start_date</field>
            <field name="value">2026-08-01</field>
        </record>
        <!-- Roles que comisionan sobre servicios (fletes, manejo, corte…):
             por defecto solo los vendedores internos. Editable en Ajustes. -->
        <record id="param_commission_service_roles" model="ir.config_parameter">
            <field name="key">om_advanced_commission.service_roles</field>
            <field name="value">internal</field>
        </record>
    </data>
</odoo>
