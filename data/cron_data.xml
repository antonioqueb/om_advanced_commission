<odoo>
    <record id="cron_commission_audit_missing" model="ir.cron">
        <field name="name">Comisiones: auditar cobros sin comisión</field>
        <field name="model_id" ref="model_commission_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_audit_missing_commissions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_commission_incidents" model="ir.cron">
        <field name="name">Comisiones: detectar incidencias de cobro (recibos vs pagos)</field>
        <field name="model_id" ref="model_commission_incident"/>
        <field name="state">code</field>
        <field name="code">model._cron_detect()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Red de seguridad: todo cobro de cliente con saldo sin aplicar se
         aplica a sus facturas abiertas (un pago sin aplicar no comisiona). -->
    <record id="cron_commission_auto_apply_payments" model="ir.cron">
        <field name="name">Comisiones: aplicar cobros de cliente a facturas</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_som_auto_apply()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
