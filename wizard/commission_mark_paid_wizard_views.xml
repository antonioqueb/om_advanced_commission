<odoo>
    <record id="view_commission_mark_paid_wizard" model="ir.ui.view">
        <field name="name">commission.mark.paid.wizard.form</field>
        <field name="model">commission.mark.paid.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Estas comisiones quedarán como <strong>Pagadas (cobradas fuera del sistema)</strong> y
                    <strong>no entrarán a ninguna liquidación</strong>. Úsalo cuando el vendedor ya recibió ese pago
                    en el pasado. Se puede revertir desde la comisión.
                </div>
                <group>
                    <field name="move_ids" widget="many2many_tags" readonly="1"/>
                    <field name="total" widget="monetary"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="note" placeholder="Ej. pagada en nómina de julio 2025 / cheque 1234…"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Marcar como cobrada" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
