<odoo>
    <record id="view_commission_audit_form" model="ir.ui.view">
        <field name="name">commission.audit.form</field>
        <field name="model">commission.audit</field>
        <field name="arch" type="xml">
            <form string="Auditoría de Cobros">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="line_count" string="Cobros sin comisión"/>
                    </group>
                </group>
                <div class="alert alert-secondary" role="alert">
                    Cobros conciliados contra facturas de cliente ligadas a órdenes con reglas de comisión que
                    <strong>no generaron ningún movimiento</strong>. "Generar faltantes" recalcula con las reglas y
                    la retención vigentes de cada orden.
                </div>
                <field name="line_ids" readonly="1">
                    <list decoration-warning="reason != ''">
                        <field name="payment_date"/>
                        <field name="invoice_name"/>
                        <field name="customer"/>
                        <field name="order_id"/>
                        <field name="amount" sum="Total"/>
                        <field name="reason"/>
                    </list>
                </field>
                <footer>
                    <button name="action_scan" string="Buscar" type="object" class="btn-primary"/>
                    <button name="action_generate" string="Generar faltantes" type="object" class="btn-secondary"
                            invisible="line_count == 0"
                            confirm="Se generarán las comisiones de todos los cobros listados. ¿Continuar?"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_commission_audit" model="ir.actions.act_window">
        <field name="name">Auditoría de Cobros</field>
        <field name="res_model">commission.audit</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_commission_audit" name="Auditoría de Cobros"
              parent="menu_commission_root" action="action_commission_audit"
              sequence="40" groups="om_advanced_commission.group_commission_manager"/>
</odoo>
