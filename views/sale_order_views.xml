<odoo>
    <!-- Alinear Comisiones desde el engrane (menú Acciones) del formulario;
         mismo método y mismo grupo que tenía el botón de cabecera. -->
    <record id="action_server_recalc_commissions" model="ir.actions.server">
        <field name="name">Alinear Comisiones</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('om_advanced_commission.group_commission_manager'))]"/>
        <field name="code">
targets = records.filtered(lambda r: r.state in ('sale', 'done'))
if targets:
    action = targets[:1].action_recalc_commissions()
        </field>
    </record>

    <record id="view_order_form_commission" model="ir.ui.view">
        <field name="name">sale.order.form.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <!-- "Alinear Comisiones" vive en el ENGRANE (menú de acciones)
                     para no saturar la cabecera; ver action_server más abajo. -->
                <button name="action_request_commission_auth"
                        string="Solicitar Autorización de Comisión"
                        type="object"
                        class="btn-warning"
                        invisible="not commission_requires_auth"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commission_moves" type="object"
                        class="oe_stat_button" icon="fa-percent"
                        invisible="commission_move_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="commission_total_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Comisiones (<field name="commission_move_count"/>)</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Gestión de Comisiones" name="commissions_rules">
                    <field name="company_currency_id" invisible="1"/>
                    <field name="commission_move_count" invisible="1"/>

                    <div class="alert alert-warning" role="alert" invisible="not commission_requires_auth">
                        <strong>Excedente retenido.</strong> Los porcentajes capturados superan lo permitido para esta orden;
                        las comisiones se devengan proporcionalmente hasta el permitido
                        (vendedores: <field name="commission_seller_effective_percent" class="oe_inline"/>%)
                        mientras no se apruebe la autorización. Los porcentajes capturados no se modifican.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state not in ['sale', 'done']">
                        Orden confirmada: puedes cambiar el comisionista. Cada cambio queda en el chatter y las
                        comisiones ya cobradas se realinean automáticamente (ajuste por diferencia si ya se pagó).
                    </div>
                    <div class="text-muted mb-2">
                        Las comisiones se devengan <b>por cobro</b>, sobre lo cobrado <b>sin IVA</b>.
                        Los <b>vendedores</b> comisionan sobre toda la orden (bienes y servicios) <b>menos las
                        comisiones externas</b>; los <b>comisionistas externos</b> (embajador, constructora,
                        referidor) solo sobre bienes tangibles. Quién comisiona sobre servicios se configura en
                        Ajustes › Comisiones.
                    </div>

                    <group string="Vendedores">
                        <group>
                            <field name="seller1_id"/>
                            <field name="seller1_percent" string="% Vendedor 1"
                                   invisible="not seller1_id"/>
                            <field name="seller2_id"/>
                            <field name="seller2_percent" string="% Vendedor 2"
                                   invisible="not seller2_id"/>
                            <field name="seller3_id"/>
                            <field name="seller3_percent" string="% Vendedor 3"
                                   invisible="not seller3_id"/>
                        </group>
                        <group>
                            <field name="total_seller_percent" readonly="1"/>
                            <field name="commission_allowed_seller_percent" readonly="1"/>
                            <field name="total_external_percent" readonly="1"/>
                            <field name="commission_allowed_external_percent" readonly="1"
                                   invisible="not commission_allowed_external_percent"/>
                            <field name="total_commission_percent" readonly="1" string="% Total Comisionado"/>
                            <field name="commission_requires_auth" readonly="1"/>
                            <field name="commission_authorization_id" readonly="1"
                                   invisible="not commission_authorization_id"/>
                        </group>
                    </group>

                    <group string="Cobrado y devengado" invisible="commission_move_count == 0">
                        <group>
                            <field name="commission_paid_base" widget="monetary" string="Cobrado sin IVA"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="commission_total_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"/>
                        </group>
                    </group>

                    <separator string="Comisionistas externos (embajador, constructora, referidor)"/>
                    <div class="text-muted mb-1">
                        Solo contactos externos. Los vendedores van arriba y no se repiten aquí.
                        Lo que se les pague aquí se <b>descuenta de la base del vendedor</b>.
                    </div>
                    <field name="external_commission_rule_ids"
                           context="{'default_role_type': 'architect'}">
                        <list string="Comisionistas externos" editable="bottom">
                            <field name="role_type"/>
                            <!-- Solo contactos EXTERNOS: quien tenga usuario interno de Odoo
                                 (vendedor) no aparece; el servidor lo valida además. -->
                            <field name="partner_id"
                                   domain="['!', ('user_ids.share', '=', False)]"
                                   options="{'no_quick_create': True}"/>
                            <field name="calculation_base"/>
                            <field name="percent" invisible="calculation_base == 'manual'"/>
                            <field name="fixed_amount" invisible="calculation_base != 'manual'"/>
                            <field name="effective_percent" readonly="1" string="% Efectivo"/>
                            <field name="estimated_amount" readonly="1" sum="Total Estimado" string="Estimado (orden completa)"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>

                    <separator string="Líneas excluidas de comisión"/>
                    <div class="text-muted mb-1">
                        Apaga una línea para que no comisione nadie. Los servicios (fletes, manejo, corte) ya
                        quedan fuera para los roles que no comisionan sobre servicios, sin necesidad de excluirlos.
                    </div>
                    <field name="order_line" nolabel="1" create="0" delete="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="display_type" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="product_template_id" string="Producto" readonly="1"/>
                            <field name="product_type" string="Tipo" readonly="1"/>
                            <field name="price_subtotal" string="Importe" readonly="1"/>
                            <field name="no_commission" string="Excluir de Comisión" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
