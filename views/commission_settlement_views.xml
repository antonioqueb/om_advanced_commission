<odoo>
    <record id="view_commission_settlement_form" model="ir.ui.view">
        <field name="name">commission.settlement.form</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Aprobar" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_create_bill" string="Generar Factura Proveedor" type="object"
                            invisible="state != 'approved' or payout_method not in ['vendor_bill', False]" class="btn-primary"/>
                    <button name="action_mark_paid" string="Marcar Pagada" type="object"
                            invisible="state != 'approved' or payout_method in ['vendor_bill', False]" class="btn-primary"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state == 'cancel'" class="btn-secondary"
                            confirm="Los movimientos regresarán a Pendiente. ¿Cancelar la liquidación?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="payout_method"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount"/>
                            <field name="vendor_bill_id" readonly="1" invisible="not vendor_bill_id"/>
                            <field name="payment_reference" readonly="state == 'invoiced'"
                                   invisible="payout_method == 'vendor_bill'"/>
                            <field name="paid_date" readonly="1" invisible="not paid_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle de Movimientos">
                            <field name="move_ids" readonly="1">
                                <list decoration-danger="amount &lt; 0">
                                    <field name="name"/>
                                    <field name="sale_order_id"/>
                                    <field name="invoice_name"/>
                                    <field name="date"/>
                                    <field name="rule_role"/>
                                    <field name="base_amount_paid" sum="Base"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="origin_move_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commission_settlement_list" model="ir.ui.view">
        <field name="name">commission.settlement.list</field>
        <field name="model">commission.settlement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="payout_method"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'invoiced'"
                       decoration-info="state == 'approved'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="action_commission_settlement" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">commission.settlement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú raíz -->
    <!-- App propia: la raíz de Comisiones sale del menú de Ventas. Visible
         para toda la fuerza de ventas; cada submenú conserva sus grupos. -->
    <menuitem id="menu_commission_root" name="Comisiones"
              web_icon="om_advanced_commission,static/description/icon_comisiones.svg"
              sequence="74"
              groups="sales_team.group_sale_salesman"/>
    <!-- menuitem sin parent NO limpia el padre viejo en el -u: se fuerza. -->
    <record id="menu_commission_root" model="ir.ui.menu">
        <field name="parent_id" eval="False"/>
    </record>

    <!-- Consulta por persona (sin liquidar) -->
    <menuitem id="menu_commission_statement" name="Estado de Cuenta"
              parent="menu_commission_root" action="action_commission_statement"
              sequence="6" groups="om_advanced_commission.group_commission_manager"/>

    <!-- Submenús operativos (solo gestores) -->
    <menuitem id="menu_commission_analysis" name="Movimientos Individuales"
              parent="menu_commission_root" action="action_commission_move"
              sequence="10" groups="om_advanced_commission.group_commission_manager"/>
    <menuitem id="menu_commission_settlement" name="Liquidaciones"
              parent="menu_commission_root" action="action_commission_settlement"
              sequence="20" groups="om_advanced_commission.group_commission_manager"/>
</odoo>
