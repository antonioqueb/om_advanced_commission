<odoo>
    <record id="module_category_commissions" model="ir.module.category">
        <field name="name">Comisiones</field>
        <field name="description">Gestión y autorización de comisiones de venta.</field>
        <field name="sequence">89</field>
    </record>

    <record id="privilege_commissions" model="res.groups.privilege">
        <field name="name">Comisiones</field>
        <field name="category_id" ref="module_category_commissions"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Administrador de Comisiones</field>
        <field name="privilege_id" ref="privilege_commissions"/>
    </record>

    <record id="group_commission_authorizer" model="res.groups">
        <field name="name">Autorizador de Comisiones</field>
        <field name="privilege_id" ref="privilege_commissions"/>
        <field name="implied_ids" eval="[(4, ref('om_advanced_commission.group_commission_manager'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="commission_move_company_rule" model="ir.rule">
        <field name="name">Commission Move: multi-company</field>
        <field name="model_id" ref="model_commission_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="commission_settlement_company_rule" model="ir.rule">
        <field name="name">Commission Settlement: multi-company</field>
        <field name="model_id" ref="model_commission_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Regla: el Administrador de Comisiones ve TODOS los movimientos.
         Las reglas de grupo se unen con OR: sin esta, un administrador que
         además es vendedor quedaba limitado a los suyos y la única forma de
         consultar a otra persona era generar una liquidación. -->
    <record id="commission_move_manager_rule" model="ir.rule">
        <field name="name">Commission Move: administrador ve todo</field>
        <field name="model_id" ref="model_commission_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('om_advanced_commission.group_commission_manager'))]"/>
    </record>

    <!-- Regla: vendedores solo ven sus propios commission.move -->
    <record id="commission_move_salesperson_rule" model="ir.rule">
        <field name="name">Commission Move: vendedor solo ve los suyos</field>
        <field name="model_id" ref="model_commission_move"/>
        <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
